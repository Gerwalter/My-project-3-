  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: Una pintura surrealista que muestra a un aventurero mirando hacia una intensa
      luz naranja.
    useTypewriter: 0
    typeSpeedOverride: 0
  - text: 'La placa en el marco dice:'
    useTypewriter: 0
    typeSpeedOverride: 0
  - text: "\u201CDonde brille la luz naranja, el camino se eleva."
    useTypewriter: 0
    typeSpeedOverride: 0
  - text: "Apunta y dispara tu gancho con G para ascender.\u201D"
    useTypewriter: 0
    typeSpeedOverride: 0
